# Скопируйте в .env и заполните перед запуском.
# Секреты сюда, .env НЕ коммитить (см. .gitignore).

# --- провайдер генерации (раздел 6 ТЗ) ---
# mock — без ключей, для разработки/проверки потока
# gemini | flux-pro | flux-max | seedream — реальные провайдеры
IMAGE_PROVIDER=mock
PROVIDER_TIMEOUT_S=30

# --- лимиты (раздел 9 ТЗ) ---
DAILY_LIMIT=50
MONTHLY_LIMIT=800

# --- загрузка ---
MAX_UPLOAD_MB=10

# --- доступ к странице: общий пароль для менеджеров (открытый вопрос §12) ---
# оставьте пустым для локальной разработки без пароля
SITE_PASSWORD=

# --- ключи провайдеров (только один нужен — тот, что выбран в IMAGE_PROVIDER) ---
GEMINI_API_KEY=
BFL_API_KEY=
FAL_API_KEY=
FAL_SEEDREAM_MODEL=
